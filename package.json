{
    "name": "@cbnsndwch/struktura-monorepo",
    "description": "Struktura - No-Code Data Management Platform",
    "version": "0.1.0",
    "license": "MIT",
    "private": true,
    "type": "module",
    "repository": "https://github.com/cbnsndwch/struktura",
    "author": {
        "name": "cbnsndwch LLC",
        "url": "https://github.com/cbnsndwch"
    },
    "bin": {
        "dvm": "./tools/dep-version-map/main.mjs"
    },
    "scripts": {
        "build": "turbo run build",
        "build:feat": "turbo run build --filter=\"./features/**/*\"",
        "clean": "turbo run clean",
        "clog": "conventional-changelog -p angular -i CHANGELOG.md -o changelog-temp.md",
        "deps": "node tools/dep-version-map.js && tools/dep-version-map.json",
        "format": "turbo run format",
        "lint:fix": "turbo run lint:fix",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "dev": "turbo run dev",
        "start": "turbo run start",
        "changeset": "changeset",
        "changeset:version": "changeset version",
        "changeset:publish": "changeset publish",
        "changeset:status": "changeset status --verbose",
        "release": "pnpm build && pnpm test && pnpm changeset:publish",
        "vset": "tsx ./scripts/version-bump.ts",
        "vtag": "tsx ./scripts/create-version-tag.ts",
        "test:telegram": "tsx ./scripts/test-telegram-bot.ts"
    },
    "devDependencies": {
        "@changesets/cli": "catalog:",
        "@eslint/js": "catalog:",
        "@types/node": "catalog:",
        "change-case": "catalog:",
        "conventional-changelog-cli": "catalog:",
        "dotenv": "catalog:",
        "eslint": "catalog:",
        "eslint-config-prettier": "catalog:",
        "eslint-import-resolver-typescript": "catalog:",
        "eslint-plugin-import": "catalog:",
        "eslint-plugin-prettier": "catalog:",
        "globals": "catalog:",
        "http-server": "catalog:",
        "npm-check-updates": "catalog:",
        "prettier": "catalog:",
        "tsx": "catalog:",
        "turbo": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "catalog:"
    },
    "jest": {
        "projects": [
            "<rootDir>/features/*",
            "<rootDir>/apps/*",
            "<rootDir>/libs/*"
        ]
    },
    "workspaces": {
        "packages": [
            "features/*",
            "apps/*",
            "libs/*",
            "tools/*"
        ]
    },
    "engines": {
        "node": ">=22",
        "npm": "please use pnpm",
        "yarn": "please use pnpm",
        "bun": "please use pnpm",
        "deno": "please use pnpm"
    },
    "pnpm": {
        "overrides": {
            "braces": ">=3.0.3",
            "micromatch": ">=4.0.8",
            "@conventional-changelog/git-client": ">=2.0.0"
        },
        "ignoredBuiltDependencies": [
            "@apollo/protobufjs",
            "@nestjs/core",
            "@scarf/scarf",
            "@tailwindcss/oxide",
            "core-js"
        ],
        "onlyBuiltDependencies": [
            "@swc/core",
            "bcrypt",
            "esbuild",
            "mongodb-memory-server",
            "protobufjs",
            "unrs-resolver"
        ]
    },
    "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a"
}
