{
    "name": "@cbnsndwch/struktura-monorepo",
    "description": "Struktura - No-Code Data Management Platform",
    "version": "0.1.0",
    "license": "MIT",
    "private": true,
    "type": "module",
    "repository": "https://github.com/cbnsndwch/struktura",
    "author": {
        "name": "cbnsndwch LLC",
        "url": "https://github.com/cbnsndwch"
    },
    "bin": {
        "dvm": "./tools/dep-version-map/main.mjs"
    },
    "scripts": {
        "build": "turbo run build",
        "build:feat": "turbo run build --filter=\"./features/**/*\"",
        "clean": "turbo run clean",
        "clog": "conventional-changelog -p angular -i CHANGELOG.md -o changelog-temp.md",
        "deps": "node tools/dep-version-map.js && tools/dep-version-map.json",
        "format": "turbo run format",
        "lint:fix": "turbo run lint:fix",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "dev": "turbo run dev",
        "start": "turbo run start",
        "changeset": "changeset",
        "changeset:version": "changeset version",
        "changeset:publish": "changeset publish",
        "changeset:status": "changeset status --verbose",
        "release": "pnpm build && pnpm test && pnpm changeset:publish",
        "vset": "tsx ./scripts/version-bump.ts",
        "vtag": "tsx ./scripts/create-version-tag.ts",
        "test:telegram": "tsx ./scripts/test-telegram-bot.ts",
        "db:seed": "tsx ./scripts/seed-test-users.ts",
        "test:e2e:login": "./scripts/run-e2e-login-tests.sh"
    },
    "devDependencies": {
        "@changesets/cli": "catalog:shared",
        "@eslint/js": "catalog:shared",
        "@types/node": "catalog:shared",
        "change-case": "catalog:shared",
        "conventional-changelog-cli": "catalog:shared",
        "dotenv": "catalog:shared",
        "eslint": "catalog:shared",
        "eslint-config-prettier": "catalog:shared",
        "eslint-import-resolver-typescript": "catalog:shared",
        "eslint-plugin-import": "catalog:shared",
        "eslint-plugin-prettier": "catalog:shared",
        "globals": "catalog:shared",
        "http-server": "catalog:shared",
        "npm-check-updates": "catalog:shared",
        "prettier": "catalog:shared",
        "tsx": "catalog:shared",
        "turbo": "catalog:shared",
        "typescript": "catalog:shared",
        "typescript-eslint": "catalog:shared"
    },
    "jest": {
        "projects": [
            "<rootDir>/features/*",
            "<rootDir>/apps/*",
            "<rootDir>/libs/*"
        ]
    },
    "workspaces": {
        "packages": [
            "features/*",
            "apps/*",
            "libs/*",
            "tools/*"
        ]
    },
    "engines": {
        "node": ">=22",
        "npm": "please use pnpm",
        "yarn": "please use pnpm",
        "bun": "please use pnpm",
        "deno": "please use pnpm"
    },
    "pnpm": {
        "overrides": {
            "braces": ">=3.0.3",
            "micromatch": ">=4.0.8",
            "@conventional-changelog/git-client": ">=2.0.0",
            "js-yaml": ">=3.14.2"
        },
        "ignoredBuiltDependencies": [
            "@apollo/protobufjs",
            "@nestjs/core",
            "@scarf/scarf",
            "@tailwindcss/oxide",
            "core-js"
        ],
        "onlyBuiltDependencies": [
            "@swc/core",
            "bcrypt",
            "esbuild",
            "mongodb-memory-server",
            "msw",
            "protobufjs"
        ]
    },
    "packageManager": "pnpm@10.25.0+sha512.5e82639027af37cf832061bcc6d639c219634488e0f2baebe785028a793de7b525ffcd3f7ff574f5e9860654e098fe852ba8ac5dd5cefe1767d23a020a92f501"
}
