{
    "name": "@cbnsndwch/struktura-shared-ui",
    "description": "Shared UI components for Struktura features",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "vite build && cpy \"src/**/*.css\" dist",
        "clean": "rm -rf dist",
        "lint": "eslint . --fix",
        "format": "prettier --write .",
        "test": "vitest --run --passWithNoTests",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@cbnsndwch/struktura-shared-contracts": "workspace:*",
        "@hookform/resolvers": "catalog:frontend",
        "@radix-ui/react-accordion": "catalog:frontend",
        "@radix-ui/react-alert-dialog": "catalog:frontend",
        "@radix-ui/react-aspect-ratio": "catalog:frontend",
        "@radix-ui/react-avatar": "catalog:frontend",
        "@radix-ui/react-checkbox": "catalog:frontend",
        "@radix-ui/react-collapsible": "catalog:frontend",
        "@radix-ui/react-context-menu": "catalog:frontend",
        "@radix-ui/react-dialog": "catalog:frontend",
        "@radix-ui/react-dropdown-menu": "catalog:frontend",
        "@radix-ui/react-hover-card": "catalog:frontend",
        "@radix-ui/react-label": "catalog:frontend",
        "@radix-ui/react-menubar": "catalog:frontend",
        "@radix-ui/react-navigation-menu": "catalog:frontend",
        "@radix-ui/react-popover": "catalog:frontend",
        "@radix-ui/react-progress": "catalog:frontend",
        "@radix-ui/react-radio-group": "catalog:frontend",
        "@radix-ui/react-scroll-area": "catalog:frontend",
        "@radix-ui/react-select": "catalog:frontend",
        "@radix-ui/react-separator": "catalog:frontend",
        "@radix-ui/react-slider": "catalog:frontend",
        "@radix-ui/react-slot": "catalog:frontend",
        "@radix-ui/react-switch": "catalog:frontend",
        "@radix-ui/react-tabs": "catalog:frontend",
        "@radix-ui/react-toast": "catalog:frontend",
        "@radix-ui/react-toggle": "catalog:frontend",
        "@radix-ui/react-toggle-group": "catalog:frontend",
        "@radix-ui/react-tooltip": "catalog:frontend",
        "@tanstack/react-table": "catalog:frontend",
        "class-variance-authority": "catalog:frontend",
        "clsx": "catalog:shared",
        "cmdk": "catalog:frontend",
        "date-fns": "catalog:shared",
        "embla-carousel-react": "catalog:frontend",
        "input-otp": "catalog:frontend",
        "lucide-react": "catalog:frontend",
        "next-themes": "catalog:frontend",
        "react-day-picker": "catalog:frontend",
        "react-hook-form": "catalog:frontend",
        "react-resizable-panels": "catalog:frontend",
        "react-router": "catalog:frontend",
        "recharts": "catalog:frontend",
        "sonner": "catalog:frontend",
        "tailwind-merge": "catalog:frontend",
        "tw-animate-css": "catalog:frontend",
        "vaul": "catalog:frontend",
        "zod": "catalog:shared"
    },
    "peerDependencies": {
        "react": "catalog:frontend",
        "react-dom": "catalog:frontend"
    },
    "devDependencies": {
        "@cbnsndwch/struktura-eslint-config": "workspace:*",
        "@cbnsndwch/struktura-tsconfig": "workspace:*",
        "@react-router/dev": "catalog:frontend",
        "@react-router/express": "catalog:frontend",
        "@react-router/node": "catalog:frontend",
        "@testing-library/jest-dom": "catalog:frontend",
        "@testing-library/react": "catalog:frontend",
        "@types/react-dom": "catalog:frontend",
        "@types/react": "catalog:frontend",
        "cpy-cli": "catalog:shared",
        "eslint": "catalog:shared",
        "glob": "catalog:shared",
        "jsdom": "catalog:frontend",
        "postcss": "catalog:frontend",
        "prettier": "catalog:shared",
        "tailwindcss-animate": "catalog:frontend",
        "tailwindcss": "catalog:frontend",
        "typescript": "catalog:shared",
        "vite-plugin-dts": "catalog:frontend",
        "vite-tsconfig-paths": "catalog:frontend",
        "vitest": "catalog:shared"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": "./dist/index.js",
        "./components/*": "./dist/components/*",
        "./hooks/*": "./dist/hooks/*",
        "./lib/*": "./dist/lib/*",
        "./globals.css": "./dist/globals.css"
    },
    "engines": {
        "node": ">=22",
        "npm": "please use pnpm",
        "yarn": "please use pnpm",
        "bun": "please use pnpm",
        "deno": "please use pnpm"
    }
}
