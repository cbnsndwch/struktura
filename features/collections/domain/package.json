{
    "name": "@cbnsndwch/struktura-collections-domain",
    "version": "0.1.0",
    "description": "Collections domain implementation for Struktura",
    "type": "module",
    "scripts": {
        "build": "tsup",
        "clean": "rm -rf dist",
        "dev": "tsup --watch",
        "lint": "eslint . --fix",
        "format": "prettier --write .",
        "test": "vitest --run --passWithNoTests",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@cbnsndwch/struktura-collections-contracts": "workspace:*",
        "@cbnsndwch/struktura-shared-contracts": "workspace:*",
        "@cbnsndwch/struktura-schema-contracts": "workspace:*",
        "@nestjs/common": "catalog:backend",
        "@nestjs/core": "catalog:backend",
        "@nestjs/graphql": "catalog:backend",
        "@nestjs/mongoose": "catalog:backend",
        "class-transformer": "catalog:shared",
        "class-validator": "catalog:shared",
        "graphql": "catalog:backend",
        "jsep": "catalog:shared",
        "mongoose": "catalog:backend"
    },
    "devDependencies": {
        "@cbnsndwch/struktura-eslint-config": "workspace:*",
        "@cbnsndwch/struktura-tsconfig": "workspace:*",
        "@types/node": "catalog:shared",
        "eslint": "catalog:shared",
        "tsup": "catalog:shared",
        "typescript": "catalog:shared",
        "vitest": "catalog:shared"
    },
    "peerDependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0"
    },
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./module": {
            "types": "./dist/collections.module.d.ts",
            "import": "./dist/collections.module.js"
        }
    }
}
